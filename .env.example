NODE_ENV=development
PORT=3100
BODY_LIMIT_BYTES=1048576
EXTERNAL_INTEGRATIONS_ENABLED=false
# 以下仅表示本地配置键；真实值由安全环境注入，不写入仓库。
DATABASE_URL=
DATABASE_SSL=false
VALKEY_URL=
JWT_SIGNING_KEY=
EVENT_QUEUE_NAME=layer-farm-events
ATTACHMENT_DIR=./data/attachments
ATTACHMENT_RETENTION_DAYS=3650
PRINT_SANDBOX_MODE=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=20
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000
# Compose专用：仅在本机安全终端注入，不写入.env.example。
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
VALKEY_PORT=56379
API_PORT=3100
WEB_PORT=8080
