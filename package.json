{
  "name": "layer-farm-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:web",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "start": "node dist/apps/api/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:coverage": "npm run build && c8 --reporter=text --reporter=lcov --reporter=json-summary --exclude-after-remap --exclude=apps/web --exclude=tests --exclude=dist --include=apps/api/src --include=packages --check-coverage --statements=95 --branches=65 --functions=90 --lines=95 node --test tests/*.test.mjs",
    "e2e:seed": "node scripts/e2e-seed.mjs",
    "trial:seed": "node scripts/trial-account-seed.mjs",
    "trial:rotate": "node scripts/trial-password-rotate.mjs",
    "trial:verify": "node scripts/verify-trial-accounts.mjs",
    "pages:verify": "node scripts/verify-public-pages.mjs",
    "e2e:cleanup": "node scripts/e2e-cleanup.mjs",
    "e2e": "playwright test --config=playwright.config.ts",
    "e2e:report": "playwright show-report --config=playwright.config.ts",
    "smoke:business": "node scripts/business-smoke.mjs",
    "p2:compose": "node scripts/p2-compose-acceptance.mjs",
    "p2:k8s": "node scripts/k8s-manifest-validate.mjs",
    "p2:large-data": "node scripts/p2-large-data-seed.mjs",
    "p2:report": "node scripts/p2-report-performance.mjs",
    "p2:load": "node scripts/p2-performance-load.mjs",
    "p2:fault": "node scripts/p2-fault-injection.mjs",
    "p2:alert": "node scripts/p2-alert-simulation.mjs",
    "security": "node scripts/security-check.mjs",
    "audit": "node scripts/dependency-scan.mjs",
    "license:check": "node scripts/license-check.mjs",
    "contract:check": "node scripts/check-openapi-contract.mjs",
    "contract:document": "node scripts/document-undocumented-operations.mjs",
    "contract:sync": "node scripts/sync-openapi-field-contract.mjs && node scripts/sync-api-mapping.mjs",
    "mapping:sync": "node scripts/sync-api-mapping.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "quality:evaluate": "node scripts/quality-gate-evaluate.mjs",
    "gate": "npm run lint && npm run typecheck && npm run contract:check && npm run test:coverage && npm run security && npm run audit && npm run license:check && npm run sbom && npm run quality:evaluate"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/plots": "^2.3.0",
    "@hono/node-server": "^2.1.11",
    "antd": "^5.29.3",
    "antd-mobile": "^5.39.0",
    "antd-mobile-icons": "^0.3.0",
    "bullmq": "^5.65.1",
    "dayjs": "^1.11.13",
    "hono": "^4.6.0",
    "ioredis": "^5.8.2",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.7",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "c8": "^9.1.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^6.3.6"
  }
}
